# Estas variáveis devem ser carregadas pelo terminal ou pelo serviço de hospedagem.
# O Django não lê este arquivo automaticamente.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Em produção: DEBUG=false, chave aleatória exclusiva, hosts/domínio HTTPS reais.
# DJANGO_SECRET_KEY=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=sgs
# POSTGRES_USER=sgs
# POSTGRES_PASSWORD=
# TRUST_PROXY_HEADERS=false
# Ative somente quando o backend não tiver acesso público e o proxy remover
# cabeçalhos forjados e definir X-Forwarded-For e X-Forwarded-Proto.
